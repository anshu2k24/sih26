# ============================================================
# PS26121 eRTMAC-NWIS — Environment Variable Template
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real secrets.
# ============================================================

# Backend Server
PORT=8000
HOST=0.0.0.0
AUTH_REQUIRED=false

# Supabase Project (get from https://supabase.com/dashboard/project/<ref>/settings/api)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service-role-key...

# JWT Secret (from Supabase → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase Direct DB Connection (backend only)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Resend Email (backend only — NEVER expose in frontend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=alerts@your-domain.com

# JWT Secret (can be same as SUPABASE_JWT_SECRET or separate)
JWT_SECRET_KEY=your-jwt-secret-key

# Frontend API URLs (used by Vite at build time)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Frontend Supabase (anon key only — safe to expose in browser)
# Put these in frontend/.env
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key...

# ============================================================
# OCR Settings
# ============================================================

# Provider options: 'mistral' (production) or 'mock' (local development / offline demo)
OCR_PROVIDER=mistral

# Mistral AI API key (Keep server-side only - NEVER expose in frontend)
MISTRAL_API_KEY=your_mistral_api_key_here

# Model to use: 'mistral-ocr-latest' or 'pixtral-12b-2409'
OCR_MODEL=mistral-ocr-latest

# OCR Timeout in milliseconds
OCR_TIMEOUT_MS=35000

# Max upload file size in Megabytes
OCR_MAX_FILE_SIZE_MB=25

# ============================================================
# RAG Intelligent Search Settings
# ============================================================

# Master switch for RAG module
RAG_ENABLED=true

# Embedding Provider: 'sentence_transformers' | 'mistral'
RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSION=384

# Vector Store: 'pgvector' (production) | 'local' (numpy dev fallback)
RAG_VECTOR_STORE=pgvector

# LLM Answer Generation (optional, set to false for search-only mode)
RAG_LLM_ENABLED=false
RAG_LLM_PROVIDER=mistral
RAG_LLM_MODEL=mistral-small-latest

# Chunking Parameters
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_MIN_CHUNK_SIZE=50
RAG_MAX_CHUNK_SIZE=1024

# Retrieval Parameters
RAG_TOP_K=10
RAG_HYBRID_SEMANTIC_WEIGHT=0.6
RAG_HYBRID_KEYWORD_WEIGHT=0.4
RAG_MAX_CONTEXT_TOKENS=4000

