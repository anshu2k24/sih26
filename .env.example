# ==============================================================================
# eRTMAC-NWIS Multi-Cloud Deployment Environment Template
# Production Architecture: VERCEL (Frontend) + RENDER (Backend) + SUPABASE + HUGGING FACE
# ==============================================================================
# 
# VARIABLE CLASSIFICATION MATRIX:
# ---------------------------------------------------------------------------------------------
# Variable                     | Target Service | Public/Secret | Required | Purpose
# ---------------------------------------------------------------------------------------------
# SUPABASE_URL                 | Render         | Secret        | YES      | Supabase Project Endpoint
# SUPABASE_ANON_KEY            | Render         | Secret        | YES      | Supabase Anonymous Key
# SUPABASE_SERVICE_ROLE_KEY    | Render         | Secret        | YES      | Supabase Admin Key (Bypasses RLS)
# SUPABASE_JWT_SECRET          | Render         | Secret        | YES      | JWT Verification Secret
# DATABASE_URL                 | Render         | Secret        | YES      | Direct PostgreSQL Connection String
# HF_TOKEN                     | Render         | Secret        | OPTIONAL | Hugging Face API Token (for Serverless Inference)
# HF_SPACE_URL                 | Render         | Secret        | OPTIONAL | Hugging Face Space Endpoint (e.g. https://your-space.hf.space)
# RAG_EMBEDDING_PROVIDER       | Render         | Public Config | YES      | 'sentence_transformers' | 'huggingface' | 'mistral'
# OCR_PROVIDER                 | Render         | Public Config | YES      | 'mistral' | 'huggingface' | 'mock'
# MISTRAL_API_KEY              | Render         | Secret        | OPTIONAL | Mistral AI API Key for OCR/Embeddings
# GEMINI_API_KEY               | Render         | Secret        | OPTIONAL | Google Gemini API Key for RAG Q&A
# CORS_ORIGINS                 | Render         | Public Config | YES      | Allowed Vercel Origins (comma-separated)
# FRONTEND_URL                 | Render         | Public Config | YES      | Vercel Production URL
# ENVIRONMENT                  | Render         | Public Config | YES      | 'production' or 'development'
# AUTH_REQUIRED                | Render         | Public Config | YES      | 'true' in production
# PORT                         | Render         | Public Config | YES      | Managed automatically by Render ($PORT)
# RESEND_API_KEY               | Render         | Secret        | OPTIONAL | Email notification dispatch
# RESEND_FROM_EMAIL            | Render         | Public Config | OPTIONAL | Sender email for alerts
# ---------------------------------------------------------------------------------------------
# VITE_API_BASE_URL            | Vercel         | Public (Vite) | YES      | Render Backend HTTPS URL
# VITE_WS_BASE_URL             | Vercel         | Public (Vite) | YES      | Render Backend WSS URL
# VITE_SUPABASE_URL            | Vercel         | Public (Vite) | YES      | Public Supabase URL
# VITE_SUPABASE_ANON_KEY       | Vercel         | Public (Vite) | YES      | Public Supabase Anon Key
# ---------------------------------------------------------------------------------------------

# ============================================================
# 1. RENDER BACKEND ENVIRONMENT VARIABLES
# ============================================================
PORT=8000
ENVIRONMENT=production
AUTH_REQUIRED=true
STREAM_IN_PROCESS=true
PYTHONPATH=src

# Frontend Domain Whitelist (Render CORS)
FRONTEND_URL=https://ertmac-nwis.vercel.app
CORS_ORIGINS=https://ertmac-nwis.vercel.app,https://sih26.vercel.app

# Supabase Credentials (Render Backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Hugging Face AI / ML Integration (Render Backend)
HF_TOKEN=hf_your_huggingface_token_here
HF_SPACE_URL=https://your-username-ertmac-ai.hf.space

# OCR Configuration
OCR_PROVIDER=mistral
OCR_MODEL=mistral-ocr-latest
MISTRAL_API_KEY=your_mistral_api_key_here
OCR_TIMEOUT_MS=35000
OCR_MAX_FILE_SIZE_MB=25

# RAG Intelligent Search Configuration
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSION=384
RAG_VECTOR_STORE=pgvector
RAG_LLM_ENABLED=true
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Notification Services (Render Backend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=alerts@ertmac-nwis.org

# ============================================================
# 2. VERCEL FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# Configure these in Vercel Project Dashboard -> Settings -> Environment Variables
VITE_API_BASE_URL=https://ertmac-backend.onrender.com
VITE_WS_BASE_URL=wss://ertmac-backend.onrender.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
