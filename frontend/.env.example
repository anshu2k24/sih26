# Frontend Environment Template
# For local dev: copy to frontend/.env
# For Vercel: configure these under Project Settings -> Environment Variables

# Backend API URL (Points to Render in production: https://ertmac-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Backend WebSocket URL (Points to Render in production: wss://ertmac-backend.onrender.com)
VITE_WS_BASE_URL=ws://localhost:8000

# Supabase Public Configuration (Safe for browser client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
